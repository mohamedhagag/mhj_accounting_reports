<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Base Template for Financial Reports -->
    <t t-name="mhj_account_reports.FinancialReportBase">
        <div class="o_action_manager o_xxl_form_view o_view_controller">
            <div class="o_control_panel">
                <div class="o_cp_top">
                    <div class="o_cp_top_left">
                        <h1 class="o_cp_title"><t t-esc="state.reportData?.company || 'Accounting Report'"/></h1>
                    </div>
                    <div class="o_cp_top_right">
                        <button class="btn btn-primary" t-on-click="() => this.applyFilters()">
                            <i class="fa fa-refresh"/> Apply Filters
                        </button>
                        <button class="btn btn-secondary" t-on-click="() => this.resetFilters()">
                            <i class="fa fa-undo"/> Reset
                        </button>
                        <button class="btn btn-success" t-on-click="() => this.exportExcel()">
                            <i class="fa fa-file-excel-o"/> Excel
                        </button>
                        <button class="btn btn-secondary" t-on-click="() => this.printReport()">
                            <i class="fa fa-print"/> PDF
                        </button>
                        <button class="btn btn-secondary" t-on-click="() => this.toggleFilters()">
                            <i class="fa fa-filter"/> Filters
                        </button>
                    </div>
                </div>
            </div>

            <!-- Filter Panel -->
            <t t-if="state.showFilters">
                <div class="mhj_filter_panel">
                    <div class="row">
                        <div class="col-md-3">
                            <label>Date From</label>
                            <input type="date" class="form-control" t-model="state.filters.date_from" />
                        </div>
                        <div class="col-md-3">
                            <label>Date To</label>
                            <input type="date" class="form-control" t-model="state.filters.date_to" />
                        </div>
                        <div class="col-md-3">
                            <label>Entry Status</label>
                            <select class="form-control" t-model="state.filters.state">
                                <option value="all">All Entries</option>
                                <option value="posted">Posted Only</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label>Display Account</label>
                            <select class="form-control" t-model="state.filters.display_account">
                                <option value="all">All Accounts</option>
                                <option value="movement">With Movements</option>
                                <option value="not_zero">Balance Not Zero</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <label>Journals</label>
                            <input type="text" class="form-control" placeholder="Search journals..."
                                   t-model="state.filterText.journals"
                                   t-on-input="() => this.filterItems('journals')"/>
                            <div class="list-group mt-2" style="max-height: 150px; overflow-y: auto;">
                                <t t-foreach="state.filteredJournals" t-as="journal" t-key="journal.id || journal_index">
                                    <a href="#" class="list-group-item list-group-item-action p-2 small"
                                       t-on-click.prevent="() => this.toggleItem('journal_ids', journal.id, journal.name)">
                                        <t t-if="state.filters.journal_ids?.includes(journal.id)">
                                            <i class="fa fa-check-square-o text-success"/>
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-square-o text-muted"/>
                                        </t>
                                        <t t-esc="journal.code"/> - <t t-esc="journal.name"/>
                                    </a>
                                </t>
                            </div>
                            <div t-if="state.filters.journal_ids?.length > 0" class="mt-2">
                                <small class="text-muted">Selected: <t t-esc="state.filters.journal_ids.length"/></small>
                                <button class="btn btn-sm btn-link" t-on-click="() => this.clearFilter('journal_ids')">Clear</button>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label>Accounts</label>
                            <input type="text" class="form-control" placeholder="Search accounts..."
                                   t-model="state.filterText.accounts"
                                   t-on-input="() => this.filterItems('accounts')"/>
                            <div class="list-group mt-2" style="max-height: 150px; overflow-y: auto;">
                                <t t-foreach="state.filteredAccounts" t-as="account" t-key="account.id || account_index">
                                    <a href="#" class="list-group-item list-group-item-action p-2 small"
                                       t-on-click.prevent="() => this.toggleItem('account_ids', account.id, account.code)">
                                        <t t-if="state.filters.account_ids?.includes(account.id)">
                                            <i class="fa fa-check-square-o text-success"/>
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-square-o text-muted"/>
                                        </t>
                                        <t t-esc="account.code"/> - <t t-esc="account.name"/>
                                    </a>
                                </t>
                            </div>
                            <div t-if="state.filters.account_ids?.length > 0" class="mt-2">
                                <small class="text-muted">Selected: <t t-esc="state.filters.account_ids.length"/></small>
                                <button class="btn btn-sm btn-link" t-on-click="() => this.clearFilter('account_ids')">Clear</button>
                            </div>
                        </div>
                    </div>
                </div>
            </t>

            <!-- Content Area -->
            <div class="o_content mhj_report_content" style="padding: 20px; background: white; overflow-y: auto;">
                <!-- Debug info -->
                <div style="font-size: 10px; color: #999; margin-bottom: 10px;">
                    Loading: <t t-esc="state.loading"/> | Has Data: <t t-esc="!!state.reportData"/> | Constructor: <t t-esc="constructor.name"/>
                </div>
                <t t-if="state.loading">
                    <div class="text-center p-5">
                        <i class="fa fa-spinner fa-spin fa-3x text-primary"/>
                        <p class="mt-3">Loading report data...</p>
                    </div>
                </t>
                <t t-else="">
                    <t t-if="constructor.contentTemplate">
                        <t t-call="{{constructor.contentTemplate}}"/>
                    </t>
                    <t t-else="">
                        <div class="alert alert-danger">No content template defined</div>
                    </t>
                </t>
            </div>
        </div>
    </t>

    <!-- Trial Balance Content -->
    <t t-name="mhj_account_reports.TrialBalanceReportContent">
        <div class="mhj_financial_report">
            <!-- Debug: Show what data we have (Collapsible) - debug assets only -->
            <t t-if="env.debug">
                <div style="background: #f0f0f0; padding: 10px; margin: 10px 0; border: 1px solid #ccc; font-size: 11px; font-family: monospace;">
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="() => state.showDebug = !state.showDebug" style="width: 100%; text-align: left;">
                        <strong>DEBUG INFO</strong> <span t-esc="state.showDebug ? '▼ Hide' : '▶ Show'"/>
                    </button>
                    <t t-if="state.showDebug">
                        <div style="margin-top: 10px; padding-top: 10px; border-top: 1px solid #ccc; max-height: 500px; overflow-y: auto;">
                            Has reportData: <t t-esc="!!state.reportData"/><br/>
                            reportData keys: <t t-esc="state.reportData ? Object.keys(state.reportData).join(', ') : 'N/A'"/><br/>
                            Accounts array length: <t t-esc="state.reportData?.accounts?.length || 0"/><br/>
                            Has totals: <t t-esc="!!state.reportData?.totals"/><br/>
                            Company: <t t-esc="state.reportData?.company || 'N/A'"/><br/>
                            Currency: <t t-esc="state.reportData?.currency_symbol || 'N/A'"/><br/>
                            Date From: <t t-esc="state.reportData?.date_from || 'N/A'"/><br/>
                            Date To: <t t-esc="state.reportData?.date_to || 'N/A'"/><br/>
                            <t t-if="state.reportData?.totals">
                                <strong>TOTALS:</strong> Initial Debit: <t t-esc="state.reportData.totals.initial_debit"/> | Period Debit: <t t-esc="state.reportData.totals.period_debit"/> | Ending Debit: <t t-esc="state.reportData.totals.ending_debit"/><br/>
                                Initial Credit: <t t-esc="state.reportData.totals.initial_credit"/> | Period Credit: <t t-esc="state.reportData.totals.period_credit"/> | Ending Credit: <t t-esc="state.reportData.totals.ending_credit"/><br/>
                            </t>
                            <t t-if="state.reportData?.accounts?.length &gt; 0">
                                <strong>ACCOUNTS DATA (showing all):</strong><br/>
                                <t t-foreach="state.reportData.accounts" t-as="acc" t-key="acc.id || acc_index">
                                    ID: <t t-esc="acc.id"/> | Code: <t t-esc="acc.code"/> | Name: <t t-esc="acc.name"/> | IDeb: <t t-esc="acc.initial_debit"/> | ICred: <t t-esc="acc.initial_credit"/> | PDeb: <t t-esc="acc.debit"/> | PCred: <t t-esc="acc.credit"/> | EDeb: <t t-esc="acc.end_debit"/> | ECred: <t t-esc="acc.end_credit"/><br/>
                                </t>
                            </t>
                        </div>
                    </t>
                </div>
            </t>
            <t t-if="state.reportData">
                <!-- Report Header Card -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h3>Trial Balance</h3>
                        <p class="mb-0">
                            Period: <t t-esc="state.reportData.date_from"/> to <t t-esc="state.reportData.date_to"/>
                        </p>
                    </div>
                </div>

                <!-- Chart Card -->
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="chart-container" style="position: relative; height: 300px;">
                            <canvas t-ref="chart"/>
                        </div>
                    </div>
                </div>

                <!-- Data Table Card -->
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover table-striped">
                                <thead class="table-light">
                                    <tr>
                                        <th>Code</th>
                                        <th>Account</th>
                                        <th class="text-end">Initial Debit</th>
                                        <th class="text-end">Initial Credit</th>
                                        <th class="text-end">Debit</th>
                                        <th class="text-end">Credit</th>
                                        <th class="text-end">Ending Debit</th>
                                        <th class="text-end">Ending Credit</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.reportData.accounts" t-as="account" t-key="account.id || account_index">
                                        <tr>
                                            <td><t t-esc="account.code"/></td>
                                            <td><t t-esc="account.name"/></td>
                                            <td class="text-end"><t t-esc="this.formatNumber(account.initial_debit)"/></td>
                                            <td class="text-end"><t t-esc="this.formatNumber(account.initial_credit)"/></td>
                                            <td class="text-end"><t t-esc="this.formatNumber(account.debit)"/></td>
                                            <td class="text-end"><t t-esc="this.formatNumber(account.credit)"/></td>
                                            <td class="text-end"><t t-esc="this.formatNumber(account.end_debit)"/></td>
                                            <td class="text-end"><t t-esc="this.formatNumber(account.end_credit)"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot class="table-dark fw-bold">
                                    <tr>
                                        <td colspan="2">TOTAL</td>
                                        <td class="text-end"><t t-esc="this.formatNumber(state.reportData.totals.initial_debit)"/></td>
                                        <td class="text-end"><t t-esc="this.formatNumber(state.reportData.totals.initial_credit)"/></td>
                                        <td class="text-end"><t t-esc="this.formatNumber(state.reportData.totals.period_debit)"/></td>
                                        <td class="text-end"><t t-esc="this.formatNumber(state.reportData.totals.period_credit)"/></td>
                                        <td class="text-end"><t t-esc="this.formatNumber(state.reportData.totals.ending_debit)"/></td>
                                        <td class="text-end"><t t-esc="this.formatNumber(state.reportData.totals.ending_credit)"/></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </t>
            <t t-else="">
                <div class="alert alert-warning">
                    <strong>No Data Available</strong><br/>
                    reportData is null or undefined<br/>
                    state.reportData = <t t-esc="state.reportData"/>
                </div>
            </t>
        </div>
    </t>

</templates>
