<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_row_stripes">
        <style type="text/css">
            .page table.mhj-striped tr &gt; th,
            .page table.mhj-striped tr &gt; td {
                box-shadow: none !important;
                border-color: #eceff1 !important;
            }
            .page table.mhj-striped &gt; thead &gt; tr &gt; th,
            .page table.mhj-striped &gt; tbody &gt; tr:nth-child(odd) &gt; th,
            .page table.mhj-striped &gt; tbody &gt; tr:nth-child(odd) &gt; td {
                background-color: #ffffff !important;
            }
            .page table.mhj-striped &gt; tbody &gt; tr:nth-child(even) &gt; th,
            .page table.mhj-striped &gt; tbody &gt; tr:nth-child(even) &gt; td {
                background-color: #f3f4f6 !important;
            }
        </style>
    </template>


    <record id="action_report_general_ledger" model="ir.actions.report">
        <field name="name">General Ledger</field>
        <field name="model">account.report.general.ledger</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">mhj_account_reports.report_general_ledger</field>
        <field name="report_file">mhj_account_reports.report_general_ledger</field>
