<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_general_ledger">
        <t t-call="web.html_container">
            <t t-set="data_report_margin_top" t-value="12"/>
            <t t-set="data_report_header_spacing" t-value="9"/>
            <t t-set="data_report_dpi" t-value="110"/>
            <t t-call="web.internal_layout">
                <t t-call="mhj_account_reports.report_column_colors"/>
                <div class="page">
                    <h2><span t-esc="res_company.name"/>: General ledger</h2>

                    <div class="row mt32">
                        <div class="col-4">
                            <strong>Journals:</strong>
                              <p t-esc="', '.join([ lt or '' for lt in print_journal ])"/>
                        </div>
                        <t groups="analytic.group_analytic_accounting">
                            <t t-if="analytic_account_ids">
                                <div class="col-4">
                                    <strong>Analytic Accounts:</strong>
                                      <p t-esc="', '.join([aa.name or '' for aa in analytic_account_ids ])"/>
                                </div>
                            </t>
                        </t>
                        <div class="col-4">
                            <strong>Display Account</strong>
                            <p>
                                <span t-if="data['display_account'] == 'all'">All accounts'</span>
                                <span t-if="data['display_account'] == 'movement'">With movements</span>
                                <span t-if="data['display_account'] == 'not_zero'">With balance not equal to zero</span>
                            </p>
                        </div>
                        <div class="col-4">
                            <strong>Target Moves:</strong>
                            <p t-if="data['target_move'] == 'all'">All Entries</p>
                            <p t-if="data['target_move'] == 'posted'">All Posted Entries</p>
                        </div>
                    </div>
                    <div class="row mb32">
                        <div class="col-4">
                            <strong>Sorted By:</strong>
                            <p t-if="data['sortby'] == 'sort_date'">Date</p>
                            <p t-if="data['sortby'] == 'sort_journal_partner'">Journal and Partner</p>
                        </div>
                        <div class="col-4">
                            <t t-if="data['date_from']"><strong>Date from :</strong> <span t-esc="data['date_from']"/><br/></t>
                            <t t-if="data['date_to']"><strong>Date to :</strong> <span t-esc="data['date_to']"/></t>
                        </div>
                    </div>

                    <t t-set="show_currency" t-value="data.get('show_currency') or data.get('group_by_currency')"/>
                    <table class="table table-sm table-reports mhj-columns">
                        <thead>
                            <tr class="text-center">
                                <th>Date</th>
                                <th>JRNL</th>
                                <th>Partner</th>
                                <th>Ref</th>
                                <th>Move</th>
                                <t groups="analytic.group_analytic_accounting">
                                    <th>Analytic Account</th>
                                </t>
                                <th>Entry Label</th>
                                <th>Debit</th>
                                <th>Credit</th>
                                <th>Balance</th>
                                <th t-if="show_currency">Currency</th><th t-if="show_currency">Currency Debit</th><th t-if="show_currency">Currency Credit</th><th t-if="show_currency">Currency Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="Accounts" t-as="account">
                                <tr style="font-weight: bold;">
                                    <td colspan="6">
                                        <span style="color: white;" t-esc="'..'"/>
                                        <span t-esc="account['code']"/>
                                        <span t-esc="account['name']"/>
                                    </td>
                                    <t groups="analytic.group_analytic_accounting">
                                        <td></td>
                                    </t>
                                    <td class="text-end">
                                        <span t-esc="account['debit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="account['credit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="account['balance']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <t t-if="show_currency"><td/><td/><td/><td/></t>
                                </tr>
<t t-foreach="account['currency_groups'] if data.get('group_by_currency') else [{'move_lines': account['move_lines']}]" t-as="currency_group">
<tr t-if="data.get('group_by_currency')" style="font-weight: bold; background-color: #eeeeee;">
<td colspan="6"><span t-esc="currency_group['currency'].name"/></td><td groups="analytic.group_analytic_accounting"/>
<td class="text-end"><span t-esc="currency_group['debit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></td>
<td class="text-end"><span t-esc="currency_group['credit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></td>
<td class="text-end"><span t-esc="currency_group['balance']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></td>
<td><span t-esc="currency_group['currency'].name"/></td><td class="text-end"><span t-esc="currency_group['currency_debit']" t-options="{'widget': 'monetary', 'display_currency': currency_group['currency']}"/></td>
<td class="text-end"><span t-esc="currency_group['currency_credit']" t-options="{'widget': 'monetary', 'display_currency': currency_group['currency']}"/></td>
<td class="text-end"><span t-esc="currency_group['currency_balance']" t-options="{'widget': 'monetary', 'display_currency': currency_group['currency']}"/></td>
</tr>
                                <tr t-foreach="currency_group['move_lines']" t-as="line" t-att-class="'mhj-opening' if line.get('is_initial_balance') else ''">
                                    <td><span t-esc="line['ldate']"/></td>
                                    <td><span t-esc="line['lcode']"/></td>
                                    <td><span t-esc="line['partner_name']"/></td>
                                    <td><span t-if="line['lref']" t-esc="line['lref']"/></td>
                                    <td><span t-esc="line['move_name']"/></td>
                                    <t groups="analytic.group_analytic_accounting">
                                        <td><span t-esc="line['analytic_account_id']"/></td>
                                    </t>
                                    <td><span t-esc="line['lname']"/></td>
                                    <td class="text-end">
                                        <span t-esc="line['debit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="line['credit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="line['group_balance'] if data.get('group_by_currency') else line['balance']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
<t t-if="show_currency"><td><span t-esc="line['currency'].name"/></td><td class="text-end"><span t-esc="line['currency_debit']" t-options="{'widget': 'monetary', 'display_currency': line['currency']}"/></td><td class="text-end"><span t-esc="line['currency_credit']" t-options="{'widget': 'monetary', 'display_currency': line['currency']}"/></td><td class="text-end"><span t-esc="line['currency_balance']" t-options="{'widget': 'monetary', 'display_currency': line['currency']}"/></td></t>
                                </tr>
</t>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>
