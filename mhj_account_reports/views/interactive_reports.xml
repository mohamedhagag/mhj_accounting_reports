<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client Action for Interactive Trial Balance -->
    <record id="action_trial_balance_interactive" model="ir.actions.client">
        <field name="name">Trial Balance (Interactive)</field>
        <field name="tag">mhj_trial_balance_interactive</field>
        <field name="target">current</field>
    </record>

    <record id="action_general_ledger_interactive" model="ir.actions.client">
        <field name="name">General Ledger (Interactive)</field>
        <field name="tag">mhj_general_ledger_interactive</field>
        <field name="target">current</field>
    </record>

    <record id="action_partner_ledger_interactive" model="ir.actions.client">
        <field name="name">Partner Ledger (Interactive)</field>
        <field name="tag">mhj_partner_ledger_interactive</field>
        <field name="target">current</field>
    </record>

    <record id="action_cash_flow_interactive" model="ir.actions.client">
        <field name="name">Cash Flow (Interactive)</field>
        <field name="tag">mhj_cash_flow_interactive</field>
        <field name="target">current</field>
    </record>

    <record id="action_balance_sheet_interactive" model="ir.actions.client">
        <field name="name">Balance Sheet (Interactive)</field>
        <field name="tag">mhj_balance_sheet_interactive</field>
        <field name="target">current</field>
    </record>

    <record id="action_profit_loss_interactive" model="ir.actions.client">
        <field name="name">Profit &amp; Loss (Interactive)</field>
        <field name="tag">mhj_profit_loss_interactive</field>
        <field name="target">current</field>
    </record>

    <!-- Interactive Reports Menu Items -->
    <menuitem id="menu_trial_balance_interactive"
              name="Trial Balance"
              sequence="10"
              action="action_trial_balance_interactive"
              parent="menu_interactive_reports_root"
              groups="account.group_account_manager,account.group_account_user"/>

    <menuitem id="menu_general_ledger_interactive"
              name="General Ledger"
              sequence="20"
              action="action_general_ledger_interactive"
              parent="menu_interactive_reports_root"
              groups="account.group_account_manager,account.group_account_user"/>

    <menuitem id="menu_partner_ledger_interactive"
              name="Partner Ledger"
              sequence="30"
              action="action_partner_ledger_interactive"
              parent="menu_interactive_reports_root"
              groups="account.group_account_manager,account.group_account_user"/>

    <menuitem id="menu_balance_sheet_interactive"
              name="Balance Sheet"
              sequence="40"
              action="action_balance_sheet_interactive"
              parent="menu_interactive_reports_root"
              groups="account.group_account_manager,account.group_account_user"/>

    <menuitem id="menu_cash_flow_interactive"
              name="Cash Flow"
              sequence="50"
              action="action_cash_flow_interactive"
              parent="menu_interactive_reports_root"
              groups="account.group_account_manager,account.group_account_user"/>

    <menuitem id="menu_profit_loss_interactive"
              name="Profit &amp; Loss"
              sequence="60"
              action="action_profit_loss_interactive"
              parent="menu_interactive_reports_root"
              groups="account.group_account_manager,account.group_account_user"/>

</odoo>
